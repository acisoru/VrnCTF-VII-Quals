{
  "name": "vrnctf-backend",
  "version": "1.0.0",
  "description": "Backend for VRNCTF challenge with gRPC and image processing",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "proto:gen": "proto-loader-gen-types --longs=String --enums=String --defaults --oneofs --grpcLib=@grpc/grpc-js --outDir=src/proto/ ../proto/image_service.proto"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.9.0",
    "@grpc/proto-loader": "^0.7.8",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "sharp": "^0.32.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.0",
    "concurrently": "^8.2.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
